<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hudRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hud"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical">

    <!-- drag grip -->
    <View
        android:layout_width="18dp"
        android:layout_height="match_parent"
        android:id="@+id/dragHandle" />

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="8dp" android:minWidth="52dp">
        <TextView android:text="FPS" android:textColor="@color/sub" android:textSize="10sp" android:textStyle="bold"/>
        <TextView android:id="@+id/valFps" android:text="--" android:textColor="@color/cyan" android:textSize="20sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="14dp" android:minWidth="52dp">
        <TextView android:text="CPU" android:textColor="@color/sub" android:textSize="10sp" android:textStyle="bold"/>
        <TextView android:id="@+id/valCpu" android:text="--%" android:textColor="@color/green" android:textSize="20sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="14dp" android:minWidth="52dp">
        <TextView android:text="TEMP" android:textColor="@color/sub" android:textSize="10sp" android:textStyle="bold"/>
        <TextView android:id="@+id/valTemp" android:text="--°C" android:textColor="@color/red" android:textSize="20sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="14dp" android:minWidth="56dp">
        <TextView android:text="RAM" android:textColor="@color/sub" android:textSize="10sp" android:textStyle="bold"/>
        <TextView android:id="@+id/valRam" android:text="-- GB" android:textColor="@color/blue" android:textSize="20sp" android:textStyle="bold"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />

</LinearLayout>
